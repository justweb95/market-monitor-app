{
  "expo": {
    "name": "Lovac na Oglase",
    "slug": "market-monitor-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ChatGPT_Image_Apr_21__2026__10_40_33_PM-removebg-preview.png",
    "scheme": "marketmonitorapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paki-dev.marketmonitorapp"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0D1117",
        "foregroundImage": "./assets/images/ChatGPT_Image_Apr_21__2026__10_40_33_PM-removebg-preview.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/ChatGPT_Image_Apr_21__2026__10_40_33_PM-removebg-preview.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.paki_dev.marketmonitorapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "notification": {
      "vapidPublicKey": "BL3gMHNGHsWSKM-2nVoqNZA3H2MvXNG2L6qwRZQSOPCL3a_sfyvgHfE0vhmduIyDcBlyN9e-LsjssVxO-r-D05U"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification.png",
          "color": "#FF0000"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "329f43d7-cbbf-4bad-b025-cd5ddaac833a"
      }
    }
  }
}
